[
    {
        "UpdateStageName": "Userraw Directory Creation",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}userraw",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Mods Directory Creation",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}mods"
    },
    {
        "UpdateStageName": "SteamCMD Game Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "SteamCMD",
        "UpdateSourceData": "10190",
        "UpdateSourceArgs": "10190",
        "ForceDownloadPlatform": "Windows",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "AlterWare Launcher Resolver Script Download",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://raw.githubusercontent.com/spreadkiller/AMPTemplates-custom/main/resolve-launcher.sh",
        "UpdateSourceArgs": "resolve-launcher.sh",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "OverwriteExistingFiles": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "AlterWare Launcher Download (dynamic latest release)",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "{{$FullBaseDir}}resolve-launcher.sh {{$FullBaseDir}}",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "AlterWare Launcher Download (dynamic latest release)",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "Executable",
        "UpdateSourceData": "powershell.exe",
        "UpdateSourceArgs": "-NoProfile -Command \"$ErrorActionPreference='Stop'; $rel = Invoke-RestMethod -UseBasicParsing 'https://api.github.com/repos/iw4x/launcher/releases/latest'; $asset = $rel.assets | Where-Object { $_.name -like '*windows*' -and $_.name -notlike '*release-tool*' } | Select-Object -First 1; Invoke-WebRequest -UseBasicParsing -Uri $asset.browser_download_url -OutFile '{{$FullBaseDir}}launcher.zip'; Expand-Archive -Path '{{$FullBaseDir}}launcher.zip' -DestinationPath '{{$FullBaseDir}}' -Force; Remove-Item '{{$FullBaseDir}}launcher.zip'\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Client Installation",
        "UpdateStageDescription": "Updates the client using the launcher's current CLI flags (--update/--force/--path are no longer valid options upstream)",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "Executable",
        "UpdateSourceData": "powershell.exe",
        "UpdateSourceArgs": "-NoProfile -Command \"Set-Location -Path '{{$FullBaseDir}}'; & ./iw4x-launcher.exe --no-self-update --skip-launch\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Client Installation",
        "UpdateStageDescription": "Updates the client using the launcher's current CLI flags (--update/--force/--path are no longer valid options upstream)",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd ./call-of-dutymw2/10190 && chmod +x iw4x-launcher && ./iw4x-launcher --no-self-update --skip-launch\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Config File Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://raw.githubusercontent.com/spreadkiller/AMPTemplates-custom/main/call-of-dutymw2server.cfg",
        "UpdateSourceArgs": "server.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}userraw",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "GunGame Mod Install",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://raw.githubusercontent.com/spreadkiller/AMPTemplates-custom/main/gungame-mod.zip",
        "UpdateSourceTarget": "{{$FullBaseDir}}mods",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true,
        "SkipOnFailure": true
    },
    {
        "UpdateStageName": "Initialise Wine",
        "UpdateStageDescription": "win64 prefix, not win32 -- Steam now ships a 64-bit iw4mp.exe for app 10190, and a win32-only prefix cannot load any 64-bit binary at all (a win64 prefix supports both 32- and 64-bit)",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"rm -rf \\\"{{$FullRootDir}}.wine\\\" >/dev/null 2>&1; WINEPREFIX=\\\"{{$FullRootDir}}.wine\\\" WINEARCH=win64 WINEDEBUG=-all XDG_RUNTIME_DIR=/tmp /usr/bin/wineboot --init\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Disable Prefix Sound",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd call-of-dutymw2 && [[ -f winetricks ]] && rm -f winetricks; wget -q https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks && chmod +x winetricks; export WINEPREFIX=\\\"{{$FullRootDir}}.wine\\\"; export WINEARCH=win64; export XDG_RUNTIME_DIR=/tmp; ./winetricks sound=disabled > winescript_log.txt 2>&1\"",
        "SkipOnFailure": true
    }
]
